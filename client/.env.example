# Copy to client/.env.local.
#
# Every NEXT_PUBLIC_* variable is inlined into the browser bundle, so only
# public values belong here. Never put OPENAI_API_KEY or JWT_SECRET in the
# client: all AI calls go through the Express API.

# Local development: call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production, recommended same-origin mode (see DEPLOYMENT.md):
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_PROXY_TARGET=https://<your-render-service>.onrender.com
# Vercel then proxies /api/v1/* to the API, so the session cookie is
# first-party and works in browsers that block third-party cookies.
# API_PROXY_TARGET=
