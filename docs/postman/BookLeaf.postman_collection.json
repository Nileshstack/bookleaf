              "raw": "{\n  \"body\": \"Any update on this?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reply on my ticket\n\nA reply to a Resolved ticket reopens it (status → Open). Closed tickets reject replies with `409 TICKET_CLOSED`."
          }
        }
      ]
