        {
          "name": "POST /tickets · Raise a ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"BK005\",\n  \"subject\": \"Never received any royalty\",\n  \"description\": \"My book has been live since July 2024 but I have not received a single royalty payment.\",\n  \"attachments\": [\n    {\n      \"fileName\": \"statement.pdf\",\n      \"sizeBytes\": 120000,\n      \"mimeType\": \"application/pdf\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Raise a ticket\n\nOnly these fields are accepted; anything else (status, priority, authorId...) is ignored. `bookId` must be one of the author's books, or omitted/null/\"\" for General / Account Level. The ticket is saved and returned immediately; AI classification runs afterwards in the background and never blocks creation. Limited to 20 tickets per author per hour."
          }
        },
