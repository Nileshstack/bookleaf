# Copy to server/.env and fill in. Server-side only: nothing here is ever
# sent to the browser.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/bookleaf  |  Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf

# At least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Optional. If empty the app still works: tickets are created without AI
# classification and admins write responses manually.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Allowed browser origin(s) for CORS, comma-separated.
CLIENT_URL=http://localhost:3000

# Global API rate limit per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
