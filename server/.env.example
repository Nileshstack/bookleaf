# Copy to server/.env and fill in. Server-side only: nothing here is ever
# sent to the browser.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/bookleaf  |  Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf

# At least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Optional. If empty the app still works: tickets get rule-based triage and
# admins get a reply template instead of an AI draft. Never put this key in the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI resilience and cost controls (defaults shown). See server/docs/AI_DESIGN.md.
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_CLASSIFY_ON_CREATE=true
# USD per 1M tokens, used only for cost estimates in /admin/ai/usage
AI_PRICE_INPUT_PER_MTOK=0.15
AI_PRICE_OUTPUT_PER_MTOK=0.6

# Allowed browser origin(s) for CORS, comma-separated.
CLIENT_URL=http://localhost:3000

# Server-Sent Events: heartbeat interval and max open streams per user.
SSE_HEARTBEAT_MS=25000
SSE_MAX_STREAMS_PER_USER=5

# Global API rate limit per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
